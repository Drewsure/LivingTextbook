# Rehearsal is the default. Set sqlite only for a deliberate closed/hosted pilot.
LIVING_TEXTBOOK_PERSISTENCE_PROVIDER=process-memory

# Durable writes require all of: sqlite provider, this explicit gate, server
# deployment policy gates, and either a matching signed student session or a
# server-only persistence token.
LIVING_TEXTBOOK_PERSISTENCE_ALLOW_DURABLE_WRITES=false
LIVING_TEXTBOOK_PERSISTENCE_ALLOW_OPERATIONS=false
LIVING_TEXTBOOK_PERSISTENCE_API_TOKEN=replace-with-a-server-only-secret
LIVING_TEXTBOOK_PERSISTENCE_SCHOOL_POLICY_ACCEPTED=false
LIVING_TEXTBOOK_PERSISTENCE_RETENTION_POLICY_ACCEPTED=false
LIVING_TEXTBOOK_PERSISTENCE_RELEASE_APPROVED=false
LIVING_TEXTBOOK_PERSISTENCE_RETENTION_DAYS=30
# Required data custody root for the durable SQLite database.
LIVING_TEXTBOOK_PERSISTENCE_DATA_ROOT=./data/living-textbook-data
LIVING_TEXTBOOK_PROGRESSION_DB_PATH=./data/living-textbook-data/living-textbook-progress.sqlite
# Required custody root for server-side backup and restore artifacts.
LIVING_TEXTBOOK_PERSISTENCE_BACKUP_ROOT=./data/living-textbook-backups
LIVING_TEXTBOOK_STUDENT_SESSION_SECRET=replace-with-a-second-server-only-secret
# Optional: keep the previous strong value briefly during a deliberate rotation.
LIVING_TEXTBOOK_STUDENT_SESSION_SECRET_PREVIOUS=
LIVING_TEXTBOOK_STUDENT_SESSION_TTL_SECONDS=28800
# Teacher review access is separate from student sessions and is read-only.
LIVING_TEXTBOOK_TEACHER_SESSION_SECRET=replace-with-a-third-server-only-secret
# Optional: keep the previous strong value briefly during a deliberate rotation.
LIVING_TEXTBOOK_TEACHER_SESSION_SECRET_PREVIOUS=
LIVING_TEXTBOOK_TEACHER_REVIEW_CODE=replace-with-a-school-approved-review-code
# Required comma-separated tenant allowlist for this review-code pilot path.
LIVING_TEXTBOOK_TEACHER_REVIEW_TENANTS=sample-publisher,ministar
LIVING_TEXTBOOK_TEACHER_SESSION_TTL_SECONDS=7200
